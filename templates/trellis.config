# trellis.config: the project's configuration for the trellis plugin, in git-config syntax.
# Read with `git config -f trellis.config`; `trellis config list` prints the effective values with
# their defaults, and `trellis doctor` FAILs on a key the plugin does not know (lib/schema).
#
# A key repeated is a list (protected = main, protected = develop). A backslash is written doubled:
# git config reads \b as a backspace, so the regex \bfoo\b is written \\bfoo\\b.

[project]
	name = {{project.name}}
	# es or en: the language of the generated blocks, the narrative phrases and the PR sections.
	locale = {{project.locale}}

[trellis]
	# The plugin's repository, where /trellis:retro opens the framework's lessons.
	upstream = rologr35/trellis

[git]
	releaseBranch = {{git.releaseBranch}}
	integrationBranch = {{git.integrationBranch}}
	# The name of a branch an issue is worked on; the pre-push hook and the doctor read it.
	issueBranch = ^[0-9]+-[a-z0-9-]+$
	# Claude never pushes here: guard-git refuses it and `trellis sync` writes the deny.
	protected = {{git.releaseBranch}}
	protected = {{git.integrationBranch}}
	# The bases of a pull request Claude may merge, on a person's word.
	assistantMayMergeInto = {{git.integrationBranch}}

[tracker]
	# github or none.
	kind = {{tracker.kind}}

[workspace]
	# flutter, dart or node: the extensions the hygiene looks for when a rule names a file.
	kind = {{workspace.kind}}
	# One line per package; each one has its CLAUDE.md.
	package = {{workspace.package}}

[toolchain]
	# <tool> [<minimum version>], one line per tool; the doctor FAILs when missing or older.
	require = {{toolchain.require}}
	# Files that must exist (presence only, never read).
	# envFile = .env

# A command is a name with what it runs. `check`, the rungs, the install and the secret scan name
# commands; nothing is interpolated.
[command "{{nombre}}"]
	run = {{comando}}
	description = {{qué hace}}
	# ci = the form CI runs, when it differs from run (a scanner of the staged change, say).

[command]
	# trellis check runs these, in order, fail-fast.
	check = {{nombre}}
	# install = the command a new worktree runs.
	# secretScan = the command the pre-commit hook and the CI run (gitleaks by default).

# A rung of TESTING.md. agent = false: Claude never runs it (sync writes the deny); pr = false: no
# pull request runs it. offUntil = YYYY-MM-DD when it is switched off, with its date of return.
[rung "{{nombre}}"]
	command = {{nombre de un [command]}}
	agent = true
	pr = true
	proves = {{qué prueba}}

# A gate: files whose change waits for a person's decision. The gates block of CLAUDE.md lists them.
# [gate "payments"]
# 	paths = lib/payments/**
# 	reason = moves money

[hygiene]
	# Byte limits; raising one is a ratchet the escape covers.
	rootLimit = 24576
	nestedLimit = 20480
	ruleLimit = 24576
	rulesTotalLimit = 102400
	# keepRef = <file>: #<n> | <reason>
	# namedElsewhere = <rule>.md: <file> | <reason>
	# mustNotLoad = <rule>.md: <file> | <reason>
	# frozen = <file> <bytes>, written by trellis hygiene --freeze.

[models]
	# The defaults of .claude/settings.json.
	model = {{models.model}}
	effortLevel = {{models.effortLevel}}
	autoCompactWindow = {{models.autoCompactWindow}}
