#!/usr/bin/env bash
#
# pre-push of a trellis project: every branch pushed is the integration branch, the release branch
# or matches git.issueBranch. Deleting a remote branch is not judged. Without trellis at hand it
# warns and lets the push through.

set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
. "$here/find-trellis.sh"
trellis="$(find_trellis)"
if [ -z "$trellis" ]; then
  echo 'pre-push: trellis not found (.trellis and node, PATH or the installed plugin), check skipped' >&2
  exit 0
fi
# A config that does not parse stops the hook with its error (trellis exits 3).
"$trellis" config list >/dev/null || exit 1

regex="$("$trellis" config get git.issueBranch)"
integration="$("$trellis" config get git.integrationBranch)"
release="$("$trellis" config get git.releaseBranch)"
zero='0000000000000000000000000000000000000000'
status=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  case "$local_ref" in refs/heads/*) ;; *) continue ;; esac
  branch="${local_ref#refs/heads/}"
  [ "$branch" = "$integration" ] || [ "$branch" = "$release" ] && continue
  if ! [[ "$branch" =~ $regex ]]; then
    echo "pre-push: $branch does not match git.issueBranch ($regex)" >&2
    status=1
  fi
done
exit "$status"
