{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "model": "{{models.model}}",
  "effortLevel": "{{models.effortLevel}}",
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "{{models.autoCompactWindow}}"
  },
  "permissions": {
    "allow": [
      "Bash(trellis *)",
      "EnterWorktree",
      "Bash(git worktree list*)",
      "Bash(git merge origin/{{git.integrationBranch}})",
      "Bash(git merge --abort)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git clean *)"
    ]
  },
  "extraKnownMarketplaces": {
    "trellis": {
      "source": {
        "source": "github",
        "repo": "{{trellis.upstream}}",
        "ref": "{{sha}}"
      },
      "autoUpdate": false
    }
  },
  "enabledPlugins": {
    "trellis@trellis": true
  }
}
