# trellis.config: la configuración del proyecto para el plugin trellis, en sintaxis git-config.
# Se lee con `git config -f trellis.config`; `trellis config list` imprime los valores efectivos con
# sus valores por defecto, y `trellis doctor` da FAIL ante una clave que el plugin no conoce (lib/schema).
#
# Una clave repetida es una lista (protected = main, protected = develop). Una barra invertida se
# escribe doble: git config lee \b como un retroceso, así que la regex \bfoo\b se escribe \\bfoo\\b.

[project]
	name = {{project.name}}
	# en o es: el idioma de todo lo que trellis escribe en el proyecto (el método, las plantillas,
	# los bloques generados, las frases de narrativa que revisa la higiene, las secciones del PR).
	locale = {{project.locale}}

[trellis]
	# El repositorio del plugin, donde /trellis:retro abre las lecciones del marco.
	upstream = rologr35/trellis

[git]
	releaseBranch = {{git.releaseBranch}}
	integrationBranch = {{git.integrationBranch}}
	# El nombre de una rama en la que se trabaja una issue; lo leen el hook pre-push y el doctor.
	issueBranch = ^[0-9]+-[a-z0-9-]+$
	# Claude nunca hace push aquí: guard-git lo rechaza y `trellis sync` escribe el deny.
	protected = {{git.releaseBranch}}
	protected = {{git.integrationBranch}}
	# Las bases de un pull request que Claude puede mezclar, por indicación de una persona.
	assistantMayMergeInto = {{git.integrationBranch}}

[tracker]
	# github o none.
	kind = {{tracker.kind}}

[workspace]
	# flutter, dart, node u other: las extensiones que busca la higiene cuando una rule nombra un fichero.
	# Con other, decláralas en [hygiene] namedExt: sin ellas esa comprobación no comprueba nada.
	kind = {{workspace.kind}}
	# Una línea por paquete; cada uno tiene su CLAUDE.md.
	package = {{workspace.package}}

[toolchain]
	# <herramienta> [<versión mínima>], una línea por herramienta; el doctor da FAIL si falta o es vieja.
	require = {{toolchain.require}}
	# Ficheros que deben existir (solo presencia, nunca se leen).
	# envFile = .env

# Un comando es un nombre con lo que corre. `check`, los escalones, la instalación y el escáner de
# secretos nombran comandos; nada se interpola.
[command "{{name}}"]
	run = {{command}}
	description = {{qué hace}}
	# ci = la forma que corre el CI, cuando difiere de run (un escáner de lo preparado, por ejemplo).

[command]
	# trellis check corre estos, en orden, fail-fast.
	check = {{name}}
	# install = el comando que corre un worktree nuevo.
	# secretScan = el comando que corren el hook pre-commit y el CI (gitleaks por defecto).

# Un escalón de TESTING.md. agent = false: Claude nunca lo corre (sync escribe el deny). pr = true: el
# CI propio del proyecto corre el comando del escalón (su texto ci, si no su texto run) en cada pull
# request, en un fichero de .github/workflows/; el workflow de trellis nunca corre escalones, y el
# doctor avisa cuando ningún workflow nombra el comando. pr = false: ningún pull request lo corre. offUntil = AAAA-MM-DD cuando está apagado, con su fecha de vuelta.
[rung "{{name}}"]
	command = {{nombre de un [command]}}
	agent = true
	pr = true
	proves = {{qué prueba}}

# Un gate: ficheros cuyo cambio espera la decisión de una persona. El bloque gates de CLAUDE.md los lista.
# [gate "payments"]
# 	paths = lib/payments/**
# 	reason = mueve dinero

[hygiene]
	# Límites en bytes; subir uno es un trinquete que cubre el escape.
	rootLimit = 24576
	nestedLimit = 20480
	ruleLimit = 24576
	rulesTotalLimit = 102400
	# keepRef = <fichero>: #<n> | <razón>
	# namedElsewhere = <rule>.md: <fichero> | <razón>
	# mustNotLoad = <rule>.md: <fichero> | <razón>
	# frozen = <fichero> <bytes>, lo escribe trellis hygiene --freeze.

[models]
	# Los valores por defecto de .claude/settings.json.
	model = {{models.model}}
	effortLevel = {{models.effortLevel}}
	autoCompactWindow = {{models.autoCompactWindow}}
