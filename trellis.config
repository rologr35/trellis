# trellis.config: this repository's own configuration, read by its own commands and by the guard-git
# hook that .claude/settings.json loads from the working tree. Syntax and keys: lib/schema.

[project]
	name = trellis
	locale = en

[git]
	releaseBranch = main
	# No develop branch here: issue branches open their pull requests against main.
	integrationBranch = main
	# A session never pushes to main; it merges a reviewed pull request into it.
	protected = main
	assistantMayMergeInto = main

[tracker]
	kind = github

[workspace]
	# bash and node without dependencies: no manifest, no package below the root.
	kind = other

[command "test"]
	run = ./test.sh
	description = Every suite, or the ones of its argument: `./test.sh shell`, `./test.sh node`.

[command "secrets"]
	run = gitleaks protect --staged --redact
	ci = gitleaks git --redact
	description = The secret scan of the staged change, and of the history in CI.

[command]
	check = test
	secretScan = secrets

[rung "unit"]
	command = test
	agent = true
	pr = true
	proves = Each script and each check of the hygiene, on repositories of their own, against no network.

[hygiene]
	# The extensions a rule names files by.
	namedExt = sh
	namedExt = mjs
	frozen = .claude/skills/trellis-debugging/SKILL.md 1550
	frozen = .claude/skills/trellis-merge/SKILL.md 2506
	frozen = .claude/skills/trellis-retro/SKILL.md 2047
	frozen = .claude/skills/trellis-scaffold/SKILL.md 1967
	frozen = .claude/skills/trellis-work/SKILL.md 5129
