# trellis.config: this repository's own configuration, read by the guard-git hook that
# .claude/settings.json loads from the working tree. Syntax and keys: lib/schema.

[project]
	name = trellis
	locale = en

[git]
	releaseBranch = main
	# No develop branch here: issue branches open their pull requests against main.
	integrationBranch = main
	# A session never pushes to main; it merges a reviewed pull request into it.
	protected = main
	assistantMayMergeInto = main
