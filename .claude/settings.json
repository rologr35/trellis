{
  "permissions": {
    "allow": [
      "Bash(gh pr merge *)",
      "Bash(GH_TOKEN=$(gh auth token -u rologr35) gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/guard-git.sh\""
          }
        ]
      }
    ]
  }
}
